# Copy to .env and fill in your key. .env is gitignored.

# --- deepseek (release backend) ---
FISH_API_KEY=sk-your-deepseek-key
FISH_BASE_URL=https://api.deepseek.com/v1
FISH_MODEL=deepseek-chat

# --- codemaker (dev backend) ---
# Leave empty to auto-start `codemaker serve` on a free port.
# FISH_CODEMAKER_URL=http://127.0.0.1:4123
